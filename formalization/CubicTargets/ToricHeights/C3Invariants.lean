import Cubic.ToricHeights.TernaryCyclicInvariants

/-!
# `eqn:C3invariants`

`ℤ[X,Y,Z]^{C₃} = ℤ[e₁,e₂,e₃,X²Y+Y²Z+Z²X]`, where `C₃` cyclically permutes `X,Y,Z` and
`e₁,e₂,e₃` are the homogeneous elementary symmetric polynomials. The left side is
`TernaryCyclicInvariants.invariants` (fixed ring of the generator `X ↦ Y ↦ Z ↦ X`, which
equals the fixed ring of the group it generates); the right side is the `ℤ`-subalgebra
generated by the four listed polynomials.
-/

namespace CubicTargets.ToricHeights.C3Invariants

open Cubic.ToricHeights.TernaryCyclicInvariants

def Claim : Prop :=
  invariants = Algebra.adjoin ℤ {e 1, e 2, e 3, delta}

end CubicTargets.ToricHeights.C3Invariants
