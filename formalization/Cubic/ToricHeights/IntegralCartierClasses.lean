import Cubic.ToricHeights.CartierSupportFunction

/-!
# The integral invariant Cartier class quotient

Take integral support divisors on the fan and quotient by their
character-linear equivalence. Equality of their images in the rational
character-divisor quotient is proved to mean difference by an
integral invariant character; rationalization introduces no extra relation.
The resulting integral quotient is freely generated by the anticanonical
strictly convex support class. Its rational parameter is three on that
generator, and the complex parameter is its scalar extension
(`ComplexifiedCartierClasses`).
-/

noncomputable section

namespace Cubic.ToricHeights.IntegralCartierClasses

open DivisorParameters IntegralCartierParameters

def rationalize : (ℤ × ℤ) →ₗ[ℤ] ℚ × ℚ where
  toFun d := ((d.1 : ℚ), (d.2 : ℚ))
  map_add' d e := by ext <;> simp
  map_smul' k d := by ext <;> simp

/-- The field-valued quotient does not enlarge equivalence for integral coefficients. -/
theorem same_class_iff_integral_character (d e : ℤ × ℤ) :
    classOf ℚ (rationalize d) = classOf ℚ (rationalize e) ↔
      ∃ a : ℤ, d = (e.1 - 2 * a, e.2 + a) := by
  rw [same_class_iff]
  change (d.1 : ℚ) + 2 * d.2 = (e.1 : ℚ) + 2 * e.2 ↔ _
  constructor
  · intro h
    have hz : d.1 + 2 * d.2 = e.1 + 2 * e.2 := by exact_mod_cast h
    refine ⟨d.2 - e.2, ?_⟩
    ext <;> dsimp <;> omega
  · rintro ⟨a, rfl⟩
    push_cast
    ring

def cartierDivisors : Submodule ℤ (ℤ × ℤ) where
  carrier := {d | HasIntegralSupport d}
  zero_mem' := by simp only [Set.mem_setOf_eq, hasIntegralSupport_iff]; simp
  add_mem' := by
    intro d e hd he
    simp only [Set.mem_setOf_eq] at hd he ⊢
    rw [hasIntegralSupport_iff] at hd he ⊢
    simpa only [Prod.fst_add, Prod.snd_add, add_sub_add_comm] using dvd_add hd he
  smul_mem' := by
    intro a d hd
    simp only [Set.mem_setOf_eq] at hd ⊢
    rw [hasIntegralSupport_iff] at hd ⊢
    simpa [smul_eq_mul, ← mul_sub] using dvd_mul_of_dvd_right hd a

def classMap : cartierDivisors →ₗ[ℤ] Class ℚ :=
  ((classOf ℚ).restrictScalars ℤ).comp (rationalize.comp cartierDivisors.subtype)

abbrev IntegralClass := cartierDivisors ⧸ classMap.ker

def integralClassOf : cartierDivisors →ₗ[ℤ] IntegralClass := classMap.ker.mkQ

theorem integralClassOf_eq_iff (d e : cartierDivisors) :
    integralClassOf d = integralClassOf e ↔
      ∃ a : ℤ, d.val = (e.val.1 - 2 * a, e.val.2 + a) := by
  change (Submodule.Quotient.mk d : IntegralClass) = Submodule.Quotient.mk e ↔ _
  rw [Submodule.Quotient.eq, LinearMap.mem_ker, map_sub, sub_eq_zero]
  exact same_class_iff_integral_character d.val e.val

/-- Embed the integral quotient in the rational character-divisor quotient. -/
def toRationalClass : IntegralClass →ₗ[ℤ] Class ℚ :=
  classMap.range.subtype.comp classMap.quotKerEquivRange.toLinearMap

@[simp]
theorem toRationalClass_mk (d : cartierDivisors) :
    toRationalClass (integralClassOf d) = classOf ℚ (rationalize d.val) := rfl

theorem toRationalClass_injective : Function.Injective toRationalClass :=
  Subtype.val_injective.comp classMap.quotKerEquivRange.injective

def anticanonical : cartierDivisors := ⟨(1, 1), anticanonical_integral_support⟩

def anticanonicalClass : IntegralClass := integralClassOf anticanonical

def generatorMap : ℤ →ₗ[ℤ] IntegralClass :=
  LinearMap.toSpanSingleton ℤ IntegralClass anticanonicalClass

theorem generatorMap_image (k : ℤ) :
    toRationalClass (generatorMap k) = classOf ℚ ((k : ℚ), (k : ℚ)) := by
  change toRationalClass (k • integralClassOf anticanonical) = _
  rw [← map_smul, toRationalClass_mk]
  congr 1
  ext <;> simp [rationalize, anticanonical]

theorem generatorMap_injective : Function.Injective generatorMap := by
  intro k l h
  have h' := congrArg toRationalClass h
  rw [generatorMap_image, generatorMap_image, same_class_iff] at h'
  dsimp at h'
  have : (k : ℚ) = l := by linarith
  exact_mod_cast this

theorem generatorMap_surjective : Function.Surjective generatorMap := by
  intro c
  induction c using Submodule.Quotient.induction_on with
  | _ d =>
    obtain ⟨k, hk, _⟩ := anticanonical_class_generator d.val d.property
    refine ⟨k, toRationalClass_injective ?_⟩
    change toRationalClass (generatorMap k) = toRationalClass (integralClassOf d)
    rw [generatorMap_image, toRationalClass_mk]
    exact hk.symm

/-- The primitive integral generator is computed before choosing its scalar coordinate. -/
def integralGeneratorEquiv : ℤ ≃ₗ[ℤ] IntegralClass :=
  LinearEquiv.ofBijective generatorMap ⟨generatorMap_injective, generatorMap_surjective⟩

theorem rational_parameter_generator (k : ℤ) :
    classParameter ℚ (toRationalClass (integralGeneratorEquiv k)) = 3 * (k : ℚ) := by
  change classParameter ℚ (toRationalClass (generatorMap k)) = _
  rw [generatorMap_image, classParameter_classOf]
  ring

theorem strict_integral_classes_positive (d : cartierDivisors) :
    HasStrictIntegralSupport d.val ↔
      0 < integralGeneratorEquiv.symm (integralClassOf d) := by
  let k := integralGeneratorEquiv.symm (integralClassOf d)
  have hk : generatorMap k = integralClassOf d := integralGeneratorEquiv.apply_symm_apply _
  have h := congrArg (fun c => classParameter ℚ (toRationalClass c)) hk
  change classParameter ℚ (toRationalClass (generatorMap k)) =
    classParameter ℚ (toRationalClass (integralClassOf d)) at h
  rw [generatorMap_image, toRationalClass_mk, classParameter_classOf,
    classParameter_classOf] at h
  change (k : ℚ) + 2 * k = (d.val.1 : ℚ) + 2 * d.val.2 at h
  have hz : 3 * k = d.val.1 + 2 * d.val.2 := by exact_mod_cast (by linarith :
    3 * (k : ℚ) = (d.val.1 : ℚ) + 2 * d.val.2)
  rw [hasStrictIntegralSupport_iff]
  change HasIntegralSupport d.val ∧ 0 < d.val.1 + 2 * d.val.2 ↔ 0 < k
  constructor
  · rintro ⟨_, hpos⟩
    omega
  · intro hpos
    exact ⟨d.property, by omega⟩

end Cubic.ToricHeights.IntegralCartierClasses
