import Cubic.ToricHeights.DivisorParameters

/-!
# Integral support characters for invariant boundary divisors

The fan has three maximal cones, each spanned by two boundary rays. A
Cartier support datum assigns an original integral character to each cone,
whose pairings on its rays are minus the divisor coefficients. This is a
condition on the character lattice, not a divisibility condition
introduced by definition.

For invariant integral coefficients `(s₀,σ,σ)`, such data exist precisely
when `3 ∣ s₀-σ`. Thus `D₀` fails the integral support-character condition,
while `3D₀` and the anticanonical boundary sum satisfy it. Modulo invariant
character divisors, the integral support data are generated by that boundary
sum. These are fan/character assertions; no comparison with a scheme Picard
group is made.
-/

namespace Cubic.ToricHeights.IntegralCartierParameters

open Cubic.QuadraticCorrespondence DivisorParameters

/-- A maximal cone is indexed by the one boundary ray it does not contain. -/
def HasIntegralSupport (d : ℤ × ℤ) : Prop :=
  ∀ omitted : Fin 3, ∃ m : ℤ × ℤ, ∀ i : Fin 3, i ≠ omitted →
    boundaryOrders m i = -(coefficients ℤ d i : ℚ)

theorem orders_zero (m : ℤ × ℤ) :
    boundaryOrders m 0 = -(m.1 : ℚ) - m.2 := by
  simp [boundaryOrders, ray_coordinates, CharacterLattice.pullback]
  ring

theorem orders_one (m : ℤ × ℤ) :
    boundaryOrders m 1 = 2 * (m.1 : ℚ) - m.2 := by
  simp [boundaryOrders, ray_coordinates, CharacterLattice.pullback]

theorem orders_two (m : ℤ × ℤ) :
    boundaryOrders m 2 = -(m.1 : ℚ) + 2 * m.2 := by
  simp [boundaryOrders, ray_coordinates, CharacterLattice.pullback]

theorem hasIntegralSupport_iff (d : ℤ × ℤ) :
    HasIntegralSupport d ↔ (3 : ℤ) ∣ d.1 - d.2 := by
  constructor
  · intro h
    obtain ⟨m, hm⟩ := h 2
    have h0 := hm 0 (by decide)
    have h1 := hm 1 (by decide)
    rw [orders_zero] at h0
    rw [orders_one] at h1
    simp [coefficients] at h0 h1
    have he : (d.1 : ℚ) - d.2 = 3 * m.1 := by linarith
    exact ⟨m.1, by exact_mod_cast he⟩
  · rintro ⟨t, ht⟩ omitted
    have ht' : d.1 = d.2 + 3 * t := by omega
    fin_cases omitted
    · refine ⟨(-d.2, -d.2), ?_⟩
      intro i hi
      fin_cases i
      · exact (hi rfl).elim
      · simp [orders_one, coefficients]
        ring
      · simp [orders_two, coefficients]
        ring
    · refine ⟨(d.2 + 2 * t, t), ?_⟩
      intro i hi
      fin_cases i
      · simp [orders_zero, coefficients, ht']
        ring
      · exact (hi rfl).elim
      · simp [orders_two, coefficients]
    · refine ⟨(t, d.2 + 2 * t), ?_⟩
      intro i hi
      fin_cases i
      · simp [orders_zero, coefficients, ht']
        ring
      · simp [orders_one, coefficients]
      · exact (hi rfl).elim

theorem D0_not_integral_support : ¬ HasIntegralSupport (1, 0) := by
  rw [hasIntegralSupport_iff]
  norm_num

theorem three_D0_integral_support : HasIntegralSupport (3, 0) := by
  rw [hasIntegralSupport_iff]
  norm_num

theorem anticanonical_integral_support : HasIntegralSupport (1, 1) := by
  rw [hasIntegralSupport_iff]
  norm_num

/-- The integral class step is three; it is not fixed by a choice of scale. -/
theorem degree_divisible_by_three (d : ℤ × ℤ) (hd : HasIntegralSupport d) :
    (3 : ℤ) ∣ d.1 + 2 * d.2 := by
  obtain ⟨t, ht⟩ := (hasIntegralSupport_iff d).mp hd
  exact ⟨t + d.2, by omega⟩

/-- Every integral support class is a unique integer multiple of the anticanonical class. -/
theorem anticanonical_class_generator (d : ℤ × ℤ) (hd : HasIntegralSupport d) :
    ∃! k : ℤ, classOf ℚ ((d.1 : ℚ), (d.2 : ℚ)) = classOf ℚ ((k : ℚ), (k : ℚ)) := by
  obtain ⟨k, hk⟩ := degree_divisible_by_three d hd
  refine ⟨k, ?_, ?_⟩
  · apply (same_class_iff ℚ _ _).mpr
    have h : (d.1 : ℚ) + 2 * d.2 = 3 * k := by exact_mod_cast hk
    dsimp
    linarith
  · intro j hj
    have h := (same_class_iff ℚ _ _).mp hj
    have hk' : (d.1 : ℚ) + 2 * d.2 = 3 * k := by exact_mod_cast hk
    dsimp at h
    have : (j : ℚ) = k := by linarith
    exact_mod_cast this

/-- Strict convexity: the supporting character on a maximal cone is strictly
above the support value on the unique ray outside that cone. -/
def HasStrictIntegralSupport (d : ℤ × ℤ) : Prop :=
  ∀ omitted : Fin 3, ∃ m : ℤ × ℤ,
    (∀ i : Fin 3, i ≠ omitted → boundaryOrders m i = -(coefficients ℤ d i : ℚ)) ∧
      -(coefficients ℤ d omitted : ℚ) < boundaryOrders m omitted

theorem omitted_gap (d : ℤ × ℤ) (omitted : Fin 3) (m : ℤ × ℤ)
    (hm : ∀ i : Fin 3, i ≠ omitted →
      boundaryOrders m i = -(coefficients ℤ d i : ℚ)) :
    boundaryOrders m omitted + (coefficients ℤ d omitted : ℚ) =
      (d.1 : ℚ) + 2 * d.2 := by
  have hsum : boundaryOrders m 0 + boundaryOrders m 1 + boundaryOrders m 2 = 0 := by
    rw [orders_zero, orders_one, orders_two]
    ring
  fin_cases omitted
  · have h1 := hm 1 (by decide)
    have h2 := hm 2 (by decide)
    simp [coefficients] at h1 h2 ⊢
    linarith
  · have h0 := hm 0 (by decide)
    have h2 := hm 2 (by decide)
    simp [coefficients] at h0 h2 ⊢
    linarith
  · have h0 := hm 0 (by decide)
    have h1 := hm 1 (by decide)
    simp [coefficients] at h0 h1 ⊢
    linarith

theorem hasStrictIntegralSupport_iff (d : ℤ × ℤ) :
    HasStrictIntegralSupport d ↔ HasIntegralSupport d ∧ 0 < d.1 + 2 * d.2 := by
  constructor
  · intro h
    refine ⟨fun omitted => (h omitted).imp fun _ hm => hm.1, ?_⟩
    obtain ⟨m, hm, hstrict⟩ := h 0
    have hgap := omitted_gap d 0 m hm
    have : 0 < (d.1 : ℚ) + 2 * d.2 := by linarith
    exact_mod_cast this
  · rintro ⟨h, hd⟩ omitted
    obtain ⟨m, hm⟩ := h omitted
    refine ⟨m, hm, ?_⟩
    have hgap := omitted_gap d omitted m hm
    have : 0 < (d.1 : ℚ) + 2 * d.2 := by exact_mod_cast hd
    linarith

theorem anticanonical_strict_integral_support : HasStrictIntegralSupport (1, 1) := by
  rw [hasStrictIntegralSupport_iff]
  exact ⟨anticanonical_integral_support, by norm_num⟩

/-- No integral strictly convex support class has degree between zero and three. -/
theorem strict_integral_degree_ge_three (d : ℤ × ℤ) (hd : HasStrictIntegralSupport d) :
    3 ≤ d.1 + 2 * d.2 := by
  obtain ⟨hi, hp⟩ := (hasStrictIntegralSupport_iff d).mp hd
  obtain ⟨k, hk⟩ := degree_divisible_by_three d hi
  omega

end Cubic.ToricHeights.IntegralCartierParameters
