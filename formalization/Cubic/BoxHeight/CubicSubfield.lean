import Mathlib.NumberTheory.Cyclotomic.Gal
import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic
import Mathlib.NumberTheory.NumberField.Discriminant.Different
import Mathlib.NumberTheory.NumberField.InfinitePlace.Ramification
import Mathlib.NumberTheory.NumberField.InfinitePlace.TotallyRealComplex
import Mathlib.RingTheory.ZMod.UnitsCyclic
import Mathlib.FieldTheory.Galois.Basic

/-!
# The cyclic cubic field of prime conductor `p ≡ 1 (mod 3)`

Supporting construction for the box-height lower bound. For a prime `p ≡ 1 (mod 3)`, the
Galois group of `L = ℚ(ζ_p)` is cyclic of order `p - 1`; its subgroup `H` generated by the
cube of a generator has index `3`, and `K_p = L^H` is a cubic field, Galois over `ℚ` with group
of order `3`. It is totally real, since a complex place would have a stabilizer of order `2`.
By the tower formula `|Δ_L| = N(𝔇_{L/K}) |Δ_K|^{[L:K]}` and `|Δ_L| = p^{p-2}`, `|Δ_K|` is a
power of `p` with exponent `k`, `k (p-1)/3 ≤ p - 2`, so `|Δ_K| ≤ p²`; and `|Δ_K| > 2`.
-/

noncomputable section

namespace Cubic.BoxHeight.CubicSubfield

open NumberField Polynomial

variable (p : ℕ) [hp : Fact p.Prime]

/-- `ℚ(ζ_p)`. -/
abbrev L := CyclotomicField p ℚ

instance isGalois_L : IsGalois ℚ (L p) := IsCyclotomicExtension.isGalois {p} ℚ (L p)

theorem card_gal : Nat.card (L p ≃ₐ[ℚ] L p) = p - 1 := by
  rw [IsGalois.card_aut_eq_finrank, IsCyclotomicExtension.finrank (L p)
    (cyclotomic.irreducible_rat hp.out.pos), Nat.totient_prime hp.out]

theorem isCyclic_gal : IsCyclic (L p ≃ₐ[ℚ] L p) :=
  have := ZMod.isCyclic_units_prime hp.out
  isCyclic_of_surjective (IsCyclotomicExtension.autEquivPow (L p)
    (cyclotomic.irreducible_rat hp.out.pos)).symm.toMonoidHom
    (IsCyclotomicExtension.autEquivPow _ _).symm.surjective

/-- A generator of the Galois group of `ℚ(ζ_p)`. -/
def gen : L p ≃ₐ[ℚ] L p :=
  Classical.choose (@IsCyclic.exists_generator _ _ (isCyclic_gal p))

theorem mem_zpowers_gen (σ : L p ≃ₐ[ℚ] L p) : σ ∈ Subgroup.zpowers (gen p) :=
  Classical.choose_spec (@IsCyclic.exists_generator _ _ (isCyclic_gal p)) σ

theorem orderOf_gen : orderOf (gen p) = p - 1 := by
  rw [orderOf_eq_card_of_forall_mem_zpowers (mem_zpowers_gen p), card_gal]

theorem gal_comm (σ τ : L p ≃ₐ[ℚ] L p) : σ * τ = τ * σ := by
  obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp (mem_zpowers_gen p σ)
  obtain ⟨b, rfl⟩ := Subgroup.mem_zpowers_iff.mp (mem_zpowers_gen p τ)
  rw [← zpow_add, ← zpow_add, add_comm]

/-- The subgroup of index `3`: the cubes. -/
def H : Subgroup (L p ≃ₐ[ℚ] L p) := Subgroup.zpowers (gen p ^ 3)

instance normal_H : (H p).Normal :=
  ⟨fun n hn g => by rwa [gal_comm p g n, mul_assoc, mul_inv_cancel, mul_one]⟩

variable {p}

theorem card_H (hp3 : p % 3 = 1) : Nat.card (H p) = (p - 1) / 3 := by
  rw [H, Nat.card_zpowers, orderOf_pow_of_dvd (by norm_num) (by rw [orderOf_gen]; omega),
    orderOf_gen]

variable (p)

/-- The cyclic cubic field `K_p = ℚ(ζ_p)^H`. -/
abbrev K : IntermediateField ℚ (L p) := IntermediateField.fixedField (H p)

variable {p}

theorem finrank_K (hp3 : p % 3 = 1) : Module.finrank ℚ (K p) = 3 := by
  have h1 := Module.finrank_mul_finrank ℚ (K p) (L p)
  rw [IntermediateField.finrank_fixedField_eq_card, card_H hp3,
    IsCyclotomicExtension.finrank (L p) (cyclotomic.irreducible_rat hp.out.pos),
    Nat.totient_prime hp.out] at h1
  have hp1 : 3 ∣ p - 1 := by omega
  have hpos : 0 < (p - 1) / 3 := Nat.div_pos (by have := hp.out.two_le; omega) (by norm_num)
  obtain ⟨m, hm⟩ := hp1
  rw [hm, Nat.mul_div_cancel_left _ (by norm_num)] at h1 hpos
  have : Module.finrank ℚ (K p) * m = 3 * m := by linarith
  exact Nat.eq_of_mul_eq_mul_right hpos this

instance isGalois_K : IsGalois ℚ (K p) := inferInstance

instance numberField_K : NumberField (K p) := inferInstance

theorem card_gal_K (hp3 : p % 3 = 1) : Nat.card (K p ≃ₐ[ℚ] K p) = 3 := by
  rw [IsGalois.card_aut_eq_finrank, finrank_K hp3]

open InfinitePlace in
theorem isTotallyReal_K (hp3 : p % 3 = 1) : IsTotallyReal (K p) := by
  constructor
  intro w
  by_contra hw
  have hram : w.IsRamified ℚ := by
    rw [isRamified_iff]
    exact ⟨not_isReal_iff_isComplex.mp hw, IsTotallyReal.isReal _⟩
  rw [isRamified_iff_card_stabilizer_eq_two] at hram
  have hdvd := Subgroup.card_subgroup_dvd_card (MulAction.stabilizer (K p ≃ₐ[ℚ] K p) w)
  rw [hram, card_gal_K hp3] at hdvd
  omega

theorem discr_L_natAbs : (discr (L p)).natAbs = p ^ (p - 2) := by
  rw [IsCyclotomicExtension.Rat.discr_prime p (L p)]
  rw [Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_neg, Int.natAbs_one, one_pow, one_mul,
    Int.natAbs_pow, Int.natAbs_natCast]

/-- `|Δ_{K_p}| = p^k` with `1 ≤ k ≤ 2`. -/
theorem discr_K (hp3 : p % 3 = 1) :
    ∃ k : ℕ, 1 ≤ k ∧ k ≤ 2 ∧ (discr (K p)).natAbs = p ^ k := by
  have htower := natAbs_discr_eq_absNorm_differentIdeal_mul_natAbs_discr_pow (K p) (𝓞 (K p))
    (L p) (𝓞 (L p))
  rw [discr_L_natAbs, IntermediateField.finrank_fixedField_eq_card, card_H hp3] at htower
  set r := (p - 1) / 3
  have hr3 : 3 * r = p - 1 := by simp only [r]; omega
  have hr : 0 < r := by have := hp.out.two_le; omega
  have hdvd : (discr (K p)).natAbs ^ r ∣ p ^ (p - 2) := ⟨_, by rw [htower, mul_comm]⟩
  have hdvd1 : (discr (K p)).natAbs ∣ p ^ (p - 2) :=
    dvd_trans (dvd_pow_self _ hr.ne') hdvd
  obtain ⟨k, hk, hkeq⟩ := (Nat.dvd_prime_pow hp.out).mp hdvd1
  rw [hkeq, ← pow_mul] at hdvd
  have hle := (Nat.pow_dvd_pow_iff_le_right hp.out.one_lt).mp hdvd
  have hgt := abs_discr_gt_two (K := K p) (by rw [finrank_K hp3]; norm_num)
  refine ⟨k, ?_, ?_, hkeq⟩
  · by_contra h0
    have hk0 : k = 0 := by omega
    rw [hk0, pow_zero] at hkeq
    rw [← Int.natCast_natAbs, hkeq] at hgt
    norm_num at hgt
  · by_contra h3
    have : 3 * r ≤ k * r := Nat.mul_le_mul_right _ (by omega)
    omega

end Cubic.BoxHeight.CubicSubfield
