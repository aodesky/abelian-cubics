import Cubic.SantensComparison.ToricPairData

/-! The permutation-Picard case of the general quadratic-torus data.
The height class is obtained from the metric's actual values on the rays;
the effective cone is generated by the actual open orbit divisors. -/

noncomputable section

namespace Cubic.SantensComparison.ToricPicardData

open ToricPairData ToricMetricData ToricMetricGeometry MeasureTheory

structure Lattices (P : Pair) where
  openBasis : P.OpenPicard ≃ₗ[ℤ] (ℤ × ℤ)
  adelicBasis : P.AdelicPicard ≃ₗ[ℤ] (ℤ × ℤ)
  permutation : ∀ d : Fin P.openSize → ℤ,
    openBasis (Submodule.Quotient.mk (fun i => d (P.openConjugate i)))=
      (openBasis (Submodule.Quotient.mk d)).swap

namespace Lattices

def generator {P : Pair} (L : Lattices P) (i : Fin P.orbitSize) : ℝ × ℝ :=
  let z := L.adelicBasis (Submodule.Quotient.mk (Pi.single i 1))
  (z.1,z.2)

def heightClass {P : Pair} (L : Lattices P) (φ : Support) : ℝ × ℝ :=
  ∑ i, (φ (ambientCoordinates (P.fan.realRay (P.orbitRay i)))).re • L.generator i

def effectiveCone {P : Pair} (L : Lattices P) : Set (ℝ × ℝ) :=
  {v | ∃ c : Fin P.orbitSize → ℝ,
    (∀ i, 0 ≤ c i) ∧ (∀ i, P.orbitRay i ∈ P.boundary → c i=0) ∧
      v=∑ i, c i • L.generator i}

def dualCone {P : Pair} (L : Lattices P) : Set (ℝ × ℝ) :=
  {z | ∀ d ∈ L.effectiveCone, 0 ≤ z.1*d.1+z.2*d.2}

def theta {P : Pair} (L : Lattices P) (φ : Support) : ℝ :=
  ∫ z : ℝ × ℝ in L.dualCone,
    Real.exp (-((L.heightClass φ).1*z.1+(L.heightClass φ).2*z.2))

def Pointed {P : Pair} (L : Lattices P) : Prop :=
  ∀ x ∈ L.effectiveCone, -x ∈ L.effectiveCone → x=0

/-- The rational character identifies the metrized anticanonical class,
including the real face. It is not merely an equality of ranks or exponents. -/
def Anticanonical (P : Pair) (φ : Support) (a : ℝ) (k : ℤ) : Prop :=
  ∀ i, P.Retained i → (if i ∈ P.boundary then 0 else 1 : ℝ)=
    a*(φ (ambientCoordinates (P.fan.realRay i))).re+P.pairing (k,k) i

end Lattices

end Cubic.SantensComparison.ToricPicardData
