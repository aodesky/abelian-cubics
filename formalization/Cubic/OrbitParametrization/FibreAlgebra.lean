import Cubic.OrbitParametrization.CoverSpan
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The fibre algebra `γ₁(P) = A ⊗_{A^G,P} ℚ`

For a rational point `P` of the quotient, the fibre of the cover over `P` has
coordinate ring `A ⧸ J_P`, where `J_P` is generated by `c - P(c)` for `c ∈ A^G`.
This is `A ⊗_{A^G,P} ℚ`, the algebra `γ₁(P)` of [O'Desky–Rosen, Prop. 2.4]. The
cyclic generator acts through the twist, which fixes `A^G`. The images of the
coordinates span it (`CoverSpan.span_coord`).
-/

noncomputable section

namespace Cubic.OrbitParametrization.C3Algebra

open CyclicGroupAlgebra
open Cubic.QuadraticCorrespondence Cubic.QuadraticCorrespondence.CyclotomicField
open Cubic.QuadraticCorrespondence.CyclotomicTorusGalois SplitLaurentInvariants
open Cubic.QuadraticCorrespondence.RationalCoverFunctor Cubic.QuadraticCorrespondence.RationalQuotientFunctor

variable (P : quotientFixedRing →ₐ[ℚ] ℚ)

/-- The ideal of the fibre over `P`. -/
def fibreIdeal : Ideal CoverAlg :=
  Ideal.span (Set.range fun c : quotientFixedRing =>
    quotientInclusion c - algebraMap ℚ CoverAlg (P c))

/-- The fibre algebra `A ⊗_{A^G,P} ℚ`. -/
def Fibre := CoverAlg ⧸ fibreIdeal P

instance : CommRing (Fibre P) := inferInstanceAs (CommRing (CoverAlg ⧸ fibreIdeal P))

instance : Algebra ℚ (Fibre P) := inferInstanceAs (Algebra ℚ (CoverAlg ⧸ fibreIdeal P))

/-- The quotient map `A → A ⊗_{A^G,P} ℚ`. -/
def fibreMk : CoverAlg →ₐ[ℚ] Fibre P := Ideal.Quotient.mkₐ ℚ _

theorem fibreMk_surjective : Function.Surjective (fibreMk P) :=
  Ideal.Quotient.mkₐ_surjective ℚ _

theorem fibreMk_inclusion (c : quotientFixedRing) :
    fibreMk P (quotientInclusion c) = algebraMap ℚ (Fibre P) (P c) := by
  rw [← (fibreMk P).commutes]
  apply Ideal.Quotient.eq.mpr
  exact Ideal.subset_span ⟨c, rfl⟩

theorem coverAct_inclusion (c : quotientFixedRing) :
    coverAct (quotientInclusion c) = quotientInclusion c :=
  Subtype.ext c.property.2

/-- The twist preserves the fibre ideal. -/
theorem fibreIdeal_le : fibreIdeal P ≤ (fibreIdeal P).comap coverAct := by
  rw [fibreIdeal, Ideal.span_le]
  rintro _ ⟨c, rfl⟩
  simp only [SetLike.mem_coe, Ideal.mem_comap, map_sub, AlgHom.commutes, coverAct_inclusion]
  exact Ideal.subset_span ⟨c, rfl⟩

/-- The generator acting on the fibre algebra. -/
def fibreAct : Fibre P →ₐ[ℚ] Fibre P :=
  Ideal.quotientMapₐ (fibreIdeal P) coverAct (fibreIdeal_le P)

theorem fibreAct_mk (a : CoverAlg) : fibreAct P (fibreMk P a) = fibreMk P (coverAct a) := rfl

theorem fibreAct_cube (s : Fibre P) : fibreAct P (fibreAct P (fibreAct P s)) = s := by
  obtain ⟨a, rfl⟩ := fibreMk_surjective P s
  rw [fibreAct_mk, fibreAct_mk, fibreAct_mk, coverAct_cube]

/-- The generator as an automorphism. -/
def fibreEquiv : Fibre P ≃ₐ[ℚ] Fibre P :=
  AlgEquiv.ofAlgHom (fibreAct P) ((fibreAct P).comp (fibreAct P))
    (AlgHom.ext fun s => fibreAct_cube P s) (AlgHom.ext fun s => fibreAct_cube P s)

theorem fibreEquiv_pow_three : fibreEquiv P ^ 3 = 1 := by
  ext s
  change fibreAct P (fibreAct P (fibreAct P s)) = s
  exact fibreAct_cube P s

/-- The action of `C₃` on the fibre algebra. -/
def fibreActHom : C3 →* (Fibre P ≃ₐ[ℚ] Fibre P) where
  toFun g := fibreEquiv P ^ (Multiplicative.toAdd g).val
  map_one' := by simp
  map_mul' g h := by
    change fibreEquiv P ^ (Multiplicative.toAdd g + Multiplicative.toAdd h).val = _
    rw [ZMod.val_add, ← pow_eq_pow_mod _ (fibreEquiv_pow_three P), pow_add]

theorem fibreActHom_σ (s : Fibre P) : fibreActHom P σ s = fibreAct P s := by
  change (fibreEquiv P ^ (1 : ZMod 3).val) s = _
  rw [show (1 : ZMod 3).val = 1 from rfl, pow_one]
  rfl

/-- The images of the coordinates. -/
def fibreCoord (i : ZMod 3) : Fibre P := fibreMk P (coord i)

/-- The coordinates span the fibre algebra. -/
theorem fibreCoord_span : Submodule.span ℚ (Set.range (fibreCoord P)) = ⊤ := by
  rw [eq_top_iff]
  intro s _
  obtain ⟨a, rfl⟩ := fibreMk_surjective P s
  obtain ⟨c₀, c₁, c₂, ha⟩ := span_coord a
  rw [ha]
  simp only [map_add, map_mul, fibreMk_inclusion]
  rw [← Algebra.smul_def, ← Algebra.smul_def, ← Algebra.smul_def]
  refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_ <;>
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)

/-- A map out of the cover coordinate ring is determined by the coordinates. -/
theorem coverHom_ext {L : Type*} [CommRing L] [Algebra ℚ L] (φ ψ : CoverAlg →ₐ[ℚ] L)
    (h : ∀ i, φ (coord i) = ψ (coord i)) : φ = ψ := by
  have hφ : rationalCoverPointEquiv L (mapUnits φ.toRingHom universalUnit) = φ := by
    rw [rationalCoverPointEquiv_mapUnits, universalUnit, Equiv.apply_symm_apply, AlgHom.comp_id]
  have hψ : rationalCoverPointEquiv L (mapUnits ψ.toRingHom universalUnit) = ψ := by
    rw [rationalCoverPointEquiv_mapUnits, universalUnit, Equiv.apply_symm_apply, AlgHom.comp_id]
  rw [← hφ, ← hψ]
  congr 1
  apply Subtype.ext
  apply Units.ext
  ext i
  rw [mapUnits_coefficient, mapUnits_coefficient, universalUnit_apply]
  exact h i

theorem fibreHom_ext {L : Type*} [CommRing L] [Algebra ℚ L] (φ ψ : Fibre P →ₐ[ℚ] L)
    (h : ∀ i, φ (fibreCoord P i) = ψ (fibreCoord P i)) : φ = ψ := by
  have := coverHom_ext (φ.comp (fibreMk P)) (ψ.comp (fibreMk P)) h
  apply AlgHom.ext
  intro s
  obtain ⟨a, rfl⟩ := fibreMk_surjective P s
  exact congrArg (fun χ : CoverAlg →ₐ[ℚ] L => χ a) this

/-- The map from the fibre algebra given by a cover point over `P`. -/
def fibreHom {L : Type*} [CommRing L] [Algebra ℚ L] (g : traceOneUnits L)
    (hg : quotientPoint L g = (Algebra.ofId ℚ L).comp P) : Fibre P →ₐ[ℚ] L :=
  Ideal.Quotient.liftₐ (fibreIdeal P) (rationalCoverPointEquiv L g) (by
    intro a ha
    have hle : fibreIdeal P ≤ RingHom.ker (rationalCoverPointEquiv L g) := by
      rw [fibreIdeal, Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker, map_sub, AlgHom.commutes]
      have := congrArg (fun φ : quotientFixedRing →ₐ[ℚ] L => φ c) hg
      simp only [quotientPoint, AlgHom.comp_apply, Algebra.ofId_apply] at this
      rw [this, sub_self]
    exact hle ha)

theorem fibreHom_coord {L : Type*} [CommRing L] [Algebra ℚ L] (g : traceOneUnits L)
    (hg : quotientPoint L g = (Algebra.ofId ℚ L).comp P) (i : ZMod 3) :
    fibreHom P g hg (fibreCoord P i) = (g.val : GroupAlgebra L) i := by
  change Ideal.Quotient.liftₐ _ _ _ (Ideal.Quotient.mkₐ ℚ _ (coord i)) = _
  rw [← AlgHom.comp_apply, Ideal.Quotient.liftₐ_comp, rationalCover_coord]

/-- A cover point over `P` shifted by the cyclic group is again over `P`. -/
theorem shift_over {L : Type*} [CommRing L] [Algebra ℚ L] (g : traceOneUnits L)
    (hg : quotientPoint L g = (Algebra.ofId ℚ L).comp P) (j : C3) :
    quotientPoint L (cyclicUnits L j * g) = (Algebra.ofId ℚ L).comp P := by
  rw [quotientPoint_cyclic_mul, hg]

theorem shift_apply {L : Type*} [CommRing L] (g : traceOneUnits L) (j : ZMod 3) (i : ZMod 3) :
    ((cyclicUnits L (Multiplicative.ofAdd j) * g).val : GroupAlgebra L) i =
      (g.val : GroupAlgebra L) (i - j) := by
  change (AddMonoidAlgebra.single j 1 * (g.val : GroupAlgebra L) : GroupAlgebra L) i = _
  rw [AddMonoidAlgebra.single_mul_apply, one_mul]
  congr 1
  abel

/-- A rational relation among the coordinates of the fibre forces vanishing,
using a cover point over `P` in a field: its three shifts give a circulant system
annihilated by the unit. -/
theorem coord_relation_zero {L : Type*} [Field L] [Algebra ℚ L] (g : traceOneUnits L)
    (hg : quotientPoint L g = (Algebra.ofId ℚ L).comp P) (q₀ q₁ q₂ : ℚ) (s : Fibre P)
    (hs : s = q₀ • fibreCoord P 0 + q₁ • fibreCoord P 1 + q₂ • fibreCoord P 2)
    (h0 : ∀ j : ZMod 3, fibreHom P _ (shift_over P g hg (Multiplicative.ofAdd j)) s = 0) :
    q₀ = 0 ∧ q₁ = 0 ∧ q₂ = 0 := by
  have hj : ∀ j : ZMod 3, (q₀ : L) * (g.val : GroupAlgebra L) (0 - j) +
      (q₁ : L) * (g.val : GroupAlgebra L) (1 - j) + (q₂ : L) * (g.val : GroupAlgebra L) (2 - j) = 0 := by
    intro j
    have := h0 j
    rw [hs, map_add, map_add, map_smul, map_smul, map_smul, fibreHom_coord, fibreHom_coord,
      fibreHom_coord, shift_apply, shift_apply, shift_apply] at this
    simpa [Algebra.smul_def] using this
  have e0 := hj 0
  have e1 := hj 1
  have e2 := hj 2
  simp only [sub_zero] at e0
  rw [show (0 : ZMod 3) - 1 = 2 by decide, show (1 : ZMod 3) - 1 = 0 by decide,
    show (2 : ZMod 3) - 1 = 1 by decide] at e1
  rw [show (0 : ZMod 3) - 2 = 1 by decide, show (1 : ZMod 3) - 2 = 2 by decide,
    show (2 : ZMod 3) - 2 = 0 by decide] at e2
  set G := (g.val : GroupAlgebra L)
  have hprod : G * coordinates L (q₀ : L) (q₂ : L) (q₁ : L) = 0 := by
    rw [← coordinates_coefficients L G, coordinates_mul]
    have : coordinates L (G 0 * q₀ + G 1 * q₁ + G 2 * q₂) (G 0 * q₂ + G 1 * q₀ + G 2 * q₁)
        (G 0 * q₁ + G 1 * q₂ + G 2 * q₀) = coordinates L 0 0 0 := by
      congr 1
      · linear_combination e0
      · linear_combination e2
      · linear_combination e1
    rw [this]
    simp [coordinates]
  obtain ⟨h₀, h₂, h₁⟩ := coordinates_eq_zero (g.val.isUnit.mul_right_eq_zero.mp hprod)
  have hinj : ∀ q : ℚ, (q : L) = 0 → q = 0 := fun q hq =>
    (algebraMap ℚ L).injective (by rw [map_zero, eq_ratCast]; exact hq)
  exact ⟨hinj _ h₀, hinj _ h₁, hinj _ h₂⟩

end Cubic.OrbitParametrization.C3Algebra
