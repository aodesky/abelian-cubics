import Mathlib.LinearAlgebra.Prod
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Data.Rat.Cast.Order
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

/-!
# The explicit cocharacter lattice in the toric description

In the paper's `(v₁,v₂)` coordinates the lattice is
`N_E = ℤ v₁ + ℤ v₂ + ℤ ω`, with `ω = (2v₁+v₂)/3`.
We prove that `(v₁,ω)` is an integral coordinate system and that the Galois
involution swaps the two ambient coordinates. The comparison with the
cocharacter lattice of the torus is `eqn:isoCocharLattices`
(`QuadraticCorrespondence.IsoCocharLattices`).
-/

namespace Cubic.OrbitParametrization.CocharacterLattice

def v₁ : ℚ × ℚ := (1, 0)
def v₂ : ℚ × ℚ := (0, 1)
def ω : ℚ × ℚ := (2 / 3, 1 / 3)

/-- The coordinates of `a v₁ + b ω` in the ambient `(v₁,v₂)` basis. -/
def coordinates : (ℤ × ℤ) →ₗ[ℤ] (ℚ × ℚ) where
  toFun n := ((n.1 : ℚ) + 2 * n.2 / 3, (n.2 : ℚ) / 3)
  map_add' := by intros; ext <;> simp [add_div]; ring
  map_smul' := by intros; ext <;> simp <;> ring

theorem coordinates_injective : Function.Injective coordinates := by
  rintro ⟨a, b⟩ ⟨c, d⟩ h
  have h2 := congrArg Prod.snd h
  have h1 := congrArg Prod.fst h
  change (b : ℚ) / 3 = (d : ℚ) / 3 at h2
  have hb : b = d := by exact_mod_cast (by linarith : (b : ℚ) = d)
  subst d
  change (a : ℚ) + 2 * b / 3 = (c : ℚ) + 2 * b / 3 at h1
  have ha : a = c := by exact_mod_cast (by linarith : (a : ℚ) = c)
  subst c
  rfl

/-- The lattice, represented by the image of its integral coordinates. -/
def lattice : Submodule ℤ (ℚ × ℚ) := coordinates.range

/-- This is exactly the lattice specified in the paper, including the index-three enlargement. -/
theorem lattice_eq_span : lattice = Submodule.span ℤ {v₁, v₂, ω} := by
  apply le_antisymm
  · rintro x ⟨⟨a, b⟩, rfl⟩
    have h1 : v₁ ∈ Submodule.span ℤ {v₁, v₂, ω} := Submodule.subset_span (by simp)
    have hw : ω ∈ Submodule.span ℤ {v₁, v₂, ω} := Submodule.subset_span (by simp)
    convert (Submodule.span ℤ {v₁, v₂, ω}).add_mem
      ((Submodule.span ℤ {v₁, v₂, ω}).smul_mem a h1)
      ((Submodule.span ℤ {v₁, v₂, ω}).smul_mem b hw) using 1
    ext <;> simp [coordinates, v₁, ω] <;> ring
  · apply Submodule.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨(1, 0), by ext <;> norm_num [coordinates, v₁]⟩
    · exact ⟨(-2, 3), by ext <;> norm_num [coordinates, v₂]⟩
    · exact ⟨(0, 1), by ext <;> norm_num [coordinates, ω]⟩

/-- Complex conjugation, written in the integral `(v₁,ω)` coordinates. -/
def conjugation (n : ℤ × ℤ) : ℤ × ℤ := (-2 * n.1 - n.2, 3 * n.1 + 2 * n.2)

theorem conjugation_involutive : Function.Involutive conjugation := by
  intro n
  ext <;> simp [conjugation] <;> ring

/-- The coordinate action is the swap of the paper's two rays. -/
theorem coordinates_conjugation (n : ℤ × ℤ) :
    coordinates (conjugation n) = Prod.swap (coordinates n) := by
  ext <;> simp [coordinates, conjugation] <;> ring

theorem conjugation_fixed_iff_coordinates (n : ℤ × ℤ) :
    conjugation n = n ↔ Prod.swap (coordinates n) = coordinates n := by
  rw [← coordinates_conjugation]
  exact coordinates_injective.eq_iff.symm

theorem conjugation_fixed_iff (n : ℤ × ℤ) : conjugation n = n ↔ n.2 = -3 * n.1 := by
  constructor
  · intro h
    have := congrArg Prod.fst h
    simp only [conjugation] at this
    omega
  · intro h
    ext <;> simp [conjugation, h] <;> ring

/-- The full invariant lattice, including points outside the integral cone. -/
def invariantLattice : AddSubgroup (ℤ × ℤ) where
  carrier := {n | conjugation n = n}
  zero_mem' := by simp [conjugation]
  add_mem' := by
    intro n m hn hm
    simp only [Set.mem_setOf_eq, conjugation_fixed_iff] at hn hm ⊢
    simp only [Prod.fst_add, Prod.snd_add, hn, hm]
    ring
  neg_mem' := by
    intro n hn
    simp only [Set.mem_setOf_eq, conjugation_fixed_iff] at hn ⊢
    simp only [Prod.fst_neg, Prod.snd_neg, hn]
    ring

@[simp]
theorem mem_invariantLattice (n : ℤ × ℤ) :
    n ∈ invariantLattice ↔ conjugation n = n := Iff.rfl

/-- The full invariant lattice is generated by `v₁+v₂`, whose integral
coordinates in the enlarged lattice are `(-1,3)`. -/
def invariantCoordinate : ℤ ≃+ invariantLattice where
  toFun k := ⟨(-k, 3 * k), by simp [conjugation_fixed_iff]⟩
  invFun n := -n.val.1
  left_inv k := by simp
  right_inv n := by
    apply Subtype.ext
    have h := (conjugation_fixed_iff n.val).mp n.property
    ext <;> dsimp <;> omega
  map_add' k l := by
    apply Subtype.ext
    ext <;> simp [mul_add, add_comm]

@[simp]
theorem coordinates_invariantCoordinate (k : ℤ) :
    coordinates (invariantCoordinate k) = ((k : ℚ), (k : ℚ)) := by
  ext <;> simp [coordinates, invariantCoordinate]
  ring

end Cubic.OrbitParametrization.CocharacterLattice
