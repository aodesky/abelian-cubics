import Cubic.Counting.CyclicPolynomialRealRoots
import Mathlib.Algebra.Polynomial.SpecificDegree
import Mathlib.FieldTheory.PolynomialGaloisGroup
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.Normal.Basic
import Mathlib.FieldTheory.IntermediateField.Algebraic

/-!
# The field of a cyclic cubic

A monic trace-one cubic whose Galois group is cyclic of order three has no
rational root (otherwise its Galois group would embed in that of a quadratic),
hence is irreducible. Its roots are real (`CyclicPolynomialRealRoots`).
-/

noncomputable section

namespace Cubic.Counting.CyclicCubicField

open Polynomial Cubic.QuadraticCorrespondence.CorrespondencePolynomials

theorem cubic_natDegree (a b : ℚ) : (cubic a b).natDegree = 3 := by
  unfold cubic
  compute_degree!

theorem cubic_monic (a b : ℚ) : (cubic a b).Monic := by
  unfold cubic
  monicity!

/-- The Galois group of a quadratic has at most two elements. -/
theorem card_gal_le_two (q : ℚ[X]) (hq : q.natDegree ≤ 2) : Fintype.card q.Gal ≤ 2 := by
  classical
  haveI : Fact ((q.map (algebraMap ℚ q.SplittingField)).Splits) := ⟨SplittingField.splits q⟩
  have hinj := Polynomial.Gal.galActionHom_injective q q.SplittingField
  have hroots : Fintype.card (q.rootSet q.SplittingField) ≤ 2 := by
    rw [← Set.toFinset_card]
    calc (q.rootSet q.SplittingField).toFinset.card
        ≤ (q.map (algebraMap ℚ q.SplittingField)).roots.card := by
          have hset : (q.rootSet q.SplittingField).toFinset = (q.aroots q.SplittingField).toFinset := by
            ext x
            simp only [Set.mem_toFinset, Multiset.mem_toFinset, Polynomial.mem_rootSet',
              Polynomial.mem_aroots']
          rw [hset]
          exact Multiset.toFinset_card_le _
      _ ≤ (q.map (algebraMap ℚ q.SplittingField)).natDegree := Polynomial.card_roots' _
      _ ≤ 2 := by rw [natDegree_map]; exact hq
  calc Fintype.card q.Gal ≤ Fintype.card (Equiv.Perm (q.rootSet q.SplittingField)) :=
        Fintype.card_le_of_injective _ hinj
    _ = (Fintype.card (q.rootSet q.SplittingField)).factorial := Fintype.card_perm
    _ ≤ Nat.factorial 2 := Nat.factorial_le hroots
    _ = 2 := rfl

/-- A cyclic cubic has no rational root. -/
theorem not_isRoot_of_cyclic (a b : ℚ) (hc : HasCyclicCubicGaloisGroup (cubic a b)) (r : ℚ) :
    ¬ (cubic a b).IsRoot r := by
  classical
  intro hr
  obtain ⟨q, hq⟩ := dvd_iff_isRoot.mpr hr
  have hq0 : q ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hq
    have := cubic_natDegree a b
    rw [hq, natDegree_zero] at this
    exact absurd this (by norm_num)
  have hqdeg : q.natDegree ≤ 2 := by
    have h := cubic_natDegree a b
    rw [hq, natDegree_mul (X_sub_C_ne_zero r) hq0, natDegree_X_sub_C] at h
    omega
  rw [hq] at hc
  obtain ⟨e⟩ := hc
  have h3 : Fintype.card ((X - C r) * q).Gal = 3 := by
    rw [Fintype.card_congr e.toEquiv]; rfl
  haveI : Unique (X - C r).Gal := Polynomial.Gal.uniqueGalOfSplits _ (Splits.X_sub_C r)
  have hle := Fintype.card_le_of_injective _ (Polynomial.Gal.restrictProd_injective (X - C r) q)
  have h1 : Fintype.card (X - C r).Gal = 1 := Fintype.card_unique
  rw [Fintype.card_prod, h1, one_mul, h3] at hle
  have := card_gal_le_two q hqdeg
  omega

theorem irreducible_of_cyclic (a b : ℚ) (hc : HasCyclicCubicGaloisGroup (cubic a b)) :
    Irreducible (cubic a b) :=
  Polynomial.irreducible_of_degree_le_three_of_not_isRoot
    (by rw [cubic_natDegree]; decide) (not_isRoot_of_cyclic a b hc)

section Real

variable (a b : ℚ) (hc : HasCyclicCubicGaloisGroup (cubic a b))

include hc in
theorem exists_real_root : ∃ θ : ℝ, Polynomial.aeval θ (cubic a b) = 0 := by
  have hs := CyclicPolynomialRealRoots.splits_real hc
  obtain ⟨θ, hθ⟩ := hs.exists_eval_eq_zero (by
    rw [degree_map, degree_eq_natDegree (cubic_monic a b).ne_zero, cubic_natDegree]; decide)
  exact ⟨θ, by rw [aeval_def, eval₂_eq_eval_map]; exact hθ⟩

/-- A real root of the cyclic cubic. -/
def realRoot : ℝ := (exists_real_root a b hc).choose

theorem realRoot_root : Polynomial.aeval (realRoot a b hc) (cubic a b) = 0 :=
  (exists_real_root a b hc).choose_spec

theorem minpoly_realRoot : minpoly ℚ (realRoot a b hc) = cubic a b :=
  (minpoly.eq_of_irreducible_of_monic (irreducible_of_cyclic a b hc) (realRoot_root a b hc)
    (cubic_monic a b)).symm

theorem isIntegral_realRoot : IsIntegral ℚ (realRoot a b hc) :=
  ⟨cubic a b, cubic_monic a b, by rw [← aeval_def]; exact realRoot_root a b hc⟩

/-- The field `ℚ(θ) ⊂ ℝ` generated by a real root. -/
def rootField : IntermediateField ℚ ℝ := IntermediateField.adjoin ℚ {realRoot a b hc}

theorem rootField_finrank : Module.finrank ℚ (rootField a b hc) = 3 := by
  rw [rootField, IntermediateField.adjoin.finrank (isIntegral_realRoot a b hc),
    minpoly_realRoot, cubic_natDegree]

/-- `ℚ(θ)` is the splitting field of the cubic in `ℝ`. -/
theorem rootField_eq : rootField a b hc =
    IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ) := by
  have hsplit := CyclicPolynomialRealRoots.splits_real hc
  haveI hL : (cubic a b).IsSplittingField ℚ
      (IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ)) :=
    IntermediateField.adjoin_rootSet_isSplittingField hsplit
  haveI : FiniteDimensional ℚ (IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ)) :=
    IsSplittingField.finiteDimensional _ (cubic a b)
  haveI : Normal ℚ (IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ)) :=
    Normal.of_isSplittingField (cubic a b)
  haveI : IsGalois ℚ (IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ)) :=
    isGalois_iff.mpr ⟨inferInstance, inferInstance⟩
  have hcard : Module.finrank ℚ (IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ)) = 3 := by
    rw [← IsGalois.card_aut_eq_finrank]
    obtain ⟨e⟩ := hc
    rw [Nat.card_congr ((AlgEquiv.autCongr (IsSplittingField.algEquiv _ (cubic a b))).toEquiv.trans
      e.toEquiv)]
    simp
  have hle : rootField a b hc ≤ IntermediateField.adjoin ℚ ((cubic a b).rootSet ℝ) := by
    rw [rootField, IntermediateField.adjoin_le_iff]
    rintro _ rfl
    apply IntermediateField.subset_adjoin
    rw [Polynomial.mem_rootSet]
    exact ⟨(cubic_monic a b).ne_zero, realRoot_root a b hc⟩
  exact IntermediateField.eq_of_le_of_finrank_eq hle (by rw [rootField_finrank, hcard])

end Real

end Cubic.Counting.CyclicCubicField
