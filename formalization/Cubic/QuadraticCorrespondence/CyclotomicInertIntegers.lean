import Cubic.QuadraticCorrespondence.CyclotomicInertNorm
import Cubic.QuadraticCorrespondence.CyclotomicPowerBasis
import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# The local integer ring at an inert prime

The orthonormal integral basis identifies `ℤ_p[ζ]` with the norm-integral
subring of the constructed local field. Its units have norm one; its maximal
ideal consists of the elements of norm less than one and is generated by `p`.
-/

noncomputable section

namespace Cubic.QuadraticCorrespondence.CyclotomicInertField

open Polynomial

variable (p : ℕ) [Fact p.Prime] [Fact (p % 3 = 2)]

abbrev IntegralModel := CyclotomicLocalAlgebra.Model ℤ_[p]

/-- The closed unit ball in the extension field. -/
def integers : Subring (Extension p) where
  carrier := {x | ‖x‖ ≤ 1}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' ha hb := (isNonarchimedean_spectralNorm _ _).trans (max_le ha hb)
  neg_mem' ha := by simpa only [Set.mem_setOf_eq, norm_neg] using ha
  mul_mem' ha hb := by
    simp only [Set.mem_setOf_eq, norm_mul]
    exact mul_le_one₀ ha (norm_nonneg _) hb

def integralEmbedding : IntegralModel p →+* Extension p :=
  AdjoinRoot.lift ((algebraMap ℚ_[p] (Extension p)).comp PadicInt.Coe.ringHom)
    (zeta p) (by simpa [cyclotomic_three] using zeta_relation p)

@[simp]
theorem integralEmbedding_linear (a b : ℤ_[p]) :
    integralEmbedding p (CyclotomicLocalAlgebra.linear a b) = linear p a b := by
  simp only [CyclotomicLocalAlgebra.linear, map_add, map_mul]
  rw [show integralEmbedding p (algebraMap ℤ_[p] (IntegralModel p) a) =
      algebraMap ℚ_[p] (Extension p) (a : ℚ_[p]) from AdjoinRoot.lift_of _,
    show integralEmbedding p (algebraMap ℤ_[p] (IntegralModel p) b) =
      algebraMap ℚ_[p] (Extension p) (b : ℚ_[p]) from AdjoinRoot.lift_of _,
    show integralEmbedding p (AdjoinRoot.root (cyclotomic 3 ℤ_[p])) = zeta p from
      AdjoinRoot.lift_root _]
  rfl

theorem integralEmbedding_injective : Function.Injective (integralEmbedding p) := by
  apply (injective_iff_map_eq_zero (integralEmbedding p)).mpr
  intro x hx
  obtain ⟨a, b, rfl⟩ := CyclotomicLocalAlgebra.exists_linear x
  have hn := congrArg norm hx
  rw [integralEmbedding_linear, norm_linear, norm_zero] at hn
  have ha : a = 0 := Subtype.ext (norm_eq_zero.mp
    (le_antisymm ((le_max_left _ _).trans hn.le) (norm_nonneg _)))
  have hb : b = 0 := Subtype.ext (norm_eq_zero.mp
    (le_antisymm ((le_max_right _ _).trans hn.le) (norm_nonneg _)))
  simp [ha, hb, CyclotomicLocalAlgebra.linear]

theorem integralEmbedding_mem (x : IntegralModel p) : integralEmbedding p x ∈ integers p := by
  obtain ⟨a, b, rfl⟩ := CyclotomicLocalAlgebra.exists_linear x
  change ‖integralEmbedding p _‖ ≤ 1
  rw [integralEmbedding_linear, norm_linear]
  exact max_le a.property b.property

def integralHom : IntegralModel p →+* integers p :=
  (integralEmbedding p).codRestrict (integers p) (integralEmbedding_mem p)

/-- Identification with the whole norm-integral ring. -/
def integralEquiv : IntegralModel p ≃+* integers p :=
  RingEquiv.ofBijective (integralHom p) ⟨
    fun _ _ h => integralEmbedding_injective p (congrArg Subtype.val h), by
      rintro ⟨x, hx⟩
      obtain ⟨a, b, rfl⟩ := exists_linear p x
      have hab : ‖a‖ ≤ 1 ∧ ‖b‖ ≤ 1 := by
        change ‖linear p a b‖ ≤ 1 at hx
        rwa [norm_linear, max_le_iff] at hx
      refine ⟨CyclotomicLocalAlgebra.linear (⟨a, hab.1⟩ : ℤ_[p]) (⟨b, hab.2⟩ : ℤ_[p]), ?_⟩
      exact Subtype.ext (integralEmbedding_linear p _ _)⟩

theorem isUnit_integer_iff (x : integers p) : IsUnit x ↔ ‖(x : Extension p)‖ = 1 := by
  constructor
  · rintro ⟨u, rfl⟩
    apply le_antisymm u.val.property
    have hi : ‖(u.inv : Extension p)‖ ≤ 1 := u.inv.property
    have hm : ‖(u.val : Extension p)‖ * ‖(u.inv : Extension p)‖ = 1 := by
      rw [← norm_mul]
      exact (congrArg norm (congrArg Subtype.val u.val_inv)).trans norm_one
    nlinarith [norm_nonneg (u.val : Extension p)]
  · intro hx
    have hx0 : (x : Extension p) ≠ 0 := norm_ne_zero_iff.mp (by rw [hx]; norm_num)
    let y : integers p := ⟨(x : Extension p)⁻¹, by change ‖(x : Extension p)⁻¹‖ ≤ 1; simp [hx]⟩
    exact ⟨⟨x, y, Subtype.ext (mul_inv_cancel₀ hx0),
      Subtype.ext (inv_mul_cancel₀ hx0)⟩, rfl⟩

theorem not_isUnit_integer_iff (x : integers p) : ¬ IsUnit x ↔ ‖(x : Extension p)‖ < 1 := by
  rw [isUnit_integer_iff]
  exact ne_iff_lt_iff_le.mpr x.property

instance : IsLocalRing (integers p) := IsLocalRing.of_nonunits_add fun x y hx hy => by
  change ¬ IsUnit x at hx
  change ¬ IsUnit y at hy
  change ¬ IsUnit (x + y)
  rw [not_isUnit_integer_iff] at hx hy ⊢
  exact (isNonarchimedean_spectralNorm (x : Extension p) (y : Extension p)).trans_lt (max_lt hx hy)

/-- The maximal ideal is determined by the extension norm. -/
theorem mem_maximalIdeal_iff_norm (x : integers p) :
    x ∈ IsLocalRing.maximalIdeal (integers p) ↔ ‖(x : Extension p)‖ < 1 :=
  not_isUnit_integer_iff p x

end Cubic.QuadraticCorrespondence.CyclotomicInertField
