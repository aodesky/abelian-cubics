import Cubic.QuadraticCorrespondence.CyclotomicInertIntegers
import Mathlib.FieldTheory.Finiteness

/-!
# The residue cardinality at an inert prime

For every prime `p ≡ 2 mod 3`, reduce the integral power basis modulo `p`.
The resulting quotient is the field `𝔽_p[X]/(X²+X+1)`, with `p²` elements.
Transport this through the integral-basis equivalence to identify the
local maximal ideal `(p)` and residue field. These results supply the
residue degree in the inert local logarithm and Fourier normalization.
-/

noncomputable section

namespace Cubic.QuadraticCorrespondence.CyclotomicInertField

open Polynomial

variable (p : ℕ) [Fact p.Prime] [Fact (p % 3 = 2)]

/-- The reduced polynomial quotient, before identifying it with the local residue field. -/
abbrev ResidueModel := CyclotomicLocalAlgebra.Model (ZMod p)

local instance : Fact (Irreducible (cyclotomic 3 (ZMod p))) :=
  ⟨CyclotomicInert.residue_irreducible p Fact.out⟩

def reduction : IntegralModel p →+* ResidueModel p :=
  AdjoinRoot.map PadicInt.toZMod (cyclotomic 3 ℤ_[p]) (cyclotomic 3 (ZMod p))
    (by simp [cyclotomic_three])

@[simp]
theorem reduction_linear (a b : ℤ_[p]) :
    reduction p (CyclotomicLocalAlgebra.linear a b) =
      CyclotomicLocalAlgebra.linear (PadicInt.toZMod a) (PadicInt.toZMod b) := by
  simp [reduction, CyclotomicLocalAlgebra.linear, AdjoinRoot.algebraMap_eq]

theorem reduction_surjective : Function.Surjective (reduction p) := by
  intro x
  obtain ⟨a, b, rfl⟩ := CyclotomicLocalAlgebra.exists_linear x
  obtain ⟨a', ha⟩ := ZMod.ringHom_surjective (PadicInt.toZMod : ℤ_[p] →+* ZMod p) a
  obtain ⟨b', hb⟩ := ZMod.ringHom_surjective (PadicInt.toZMod : ℤ_[p] →+* ZMod p) b
  exact ⟨CyclotomicLocalAlgebra.linear a' b', by simp [ha, hb]⟩

omit [Fact (p % 3 = 2)] in
private theorem scalar_reduction_eq_zero (a : ℤ_[p]) :
    PadicInt.toZMod a = 0 ↔ (p : ℤ_[p]) ∣ a := by
  rw [← RingHom.mem_ker, PadicInt.ker_toZMod, PadicInt.maximalIdeal_eq_span_p,
    Ideal.mem_span_singleton]

theorem ker_reduction : RingHom.ker (reduction p) = Ideal.span {(p : IntegralModel p)} := by
  ext x
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  constructor
  · obtain ⟨a, b, rfl⟩ := CyclotomicLocalAlgebra.exists_linear x
    rw [reduction_linear, CyclotomicLocalAlgebra.linear_eq_zero_iff]
    rintro ⟨ha, hb⟩
    obtain ⟨a', rfl⟩ := (scalar_reduction_eq_zero p a).mp ha
    obtain ⟨b', rfl⟩ := (scalar_reduction_eq_zero p b).mp hb
    refine ⟨CyclotomicLocalAlgebra.linear a' b', ?_⟩
    simp only [CyclotomicLocalAlgebra.linear, map_mul, map_natCast]
    ring
  · rintro ⟨y, rfl⟩
    have hp : reduction p (p : IntegralModel p) = 0 := by
      rw [map_natCast]
      rw [← map_natCast (algebraMap (ZMod p) (ResidueModel p)),
        CharP.cast_eq_zero (ZMod p) p, map_zero]
    rw [map_mul, hp, zero_mul]

/-- The field quotient has dimension two over the base residue field. -/
theorem residueModel_finrank : Module.finrank (ZMod p) (ResidueModel p) = 2 :=
  CyclotomicLocalAlgebra.finrank_model

theorem residueModel_card : Nat.card (ResidueModel p) = p ^ 2 := by
  letI : Module.Finite (ZMod p) (ResidueModel p) := (cyclotomic.monic 3 (ZMod p)).finite_adjoinRoot
  rw [Module.natCard_eq_pow_finrank (K := ZMod p), residueModel_finrank,
    Nat.card_eq_fintype_card, ZMod.card]

/-- Reduction on the norm-integral ring, using its integral-basis equivalence. -/
def residue : integers p →+* ResidueModel p :=
  (reduction p).comp (integralEquiv p).symm.toRingHom

theorem residue_surjective : Function.Surjective (residue p) :=
  (reduction_surjective p).comp (integralEquiv p).symm.surjective

theorem ker_residue : RingHom.ker (residue p) = Ideal.span {(p : integers p)} := by
  ext x
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  change reduction p ((integralEquiv p).symm x) = 0 ↔ _
  rw [← RingHom.mem_ker, ker_reduction, Ideal.mem_span_singleton]
  rw [← map_dvd_iff (integralEquiv p), map_natCast, RingEquiv.apply_symm_apply]

/-- The maximal ideal of the local integers is generated by the rational prime. -/
theorem maximalIdeal_eq_prime : IsLocalRing.maximalIdeal (integers p) =
    Ideal.span {(p : integers p)} := by
  have h := IsLocalRing.eq_maximalIdeal
    (RingHom.ker_isMaximal_of_surjective (residue p) (residue_surjective p))
  exact h.symm.trans (ker_residue p)

/-- The residue field is identified with the irreducible quadratic quotient. -/
def residueFieldEquiv : IsLocalRing.ResidueField (integers p) ≃+* ResidueModel p := by
  letI : IsLocalHom (residue p) := .of_surjective (residue p) (residue_surjective p)
  let f := IsLocalRing.ResidueField.lift (residue p)
  refine RingEquiv.ofBijective f ⟨f.injective, ?_⟩
  intro y
  obtain ⟨x, rfl⟩ := residue_surjective p y
  exact ⟨IsLocalRing.residue (integers p) x, rfl⟩

/-- The residue cardinality used by the paper. -/
theorem card_residueField : Nat.card (IsLocalRing.ResidueField (integers p)) = p ^ 2 := by
  rw [Nat.card_congr (residueFieldEquiv p).toEquiv, residueModel_card]

end Cubic.QuadraticCorrespondence.CyclotomicInertField
