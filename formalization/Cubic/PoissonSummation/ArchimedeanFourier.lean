import Cubic.ToricHeights.SupportFunction
import Cubic.PoissonSummation.FiniteEulerProduct
import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals
import Mathlib.Analysis.SpecialFunctions.Complex.Circle

/-!
# The archimedean Fourier integral in the paper's logarithmic coordinate

On the line `u ↦ u v₀ = (-u,-u)`, use the full support-function height,
the character `exp(2π i t u)`, its inverse in the Fourier integral, and Lebesgue
measure `du`. The lattice generated by `v₀` therefore has covolume one.

This proves the actual one-dimensional integral and its two displayed rational
forms in `eqn:archimedeanSpectralFactor` and `eqn:infiniteHeightFourierTransform`,
with `s₁ = s₂ = σ`. `ArchimedeanTorusFourier` transfers these results to the
original torus using the measure pushforward proved in `ArchimedeanHaar`.
No Poisson summation theorem or global quotient-measure normalization is assumed.
-/

noncomputable section

namespace Cubic.PoissonSummation.ArchimedeanFourier

open MeasureTheory Set
open Cubic.ToricHeights

/-- The inverse height is constructed from the fan, before its two pieces are computed. -/
def inverseHeight (s₀ σ : ℂ) (u : ℝ) : ℂ :=
  Complex.exp (supportFunction s₀ σ (-u, -u))

theorem continuous_inverseHeight (s₀ σ : ℂ) : Continuous (inverseHeight s₀ σ) := by
  exact Complex.continuous_exp.comp
    ((Cubic.ToricHeights.supportFunction_continuous s₀ σ).comp
      (continuous_id.neg.prodMk continuous_id.neg))

/-- The paper uses `e(x) = exp(2π i x)` and `t = m(v₀)`. -/
def character (t u : ℝ) : Circle := Circle.exp (2 * Real.pi * t * u)

/-- The Fourier convention is inverse character, with the height left unchanged. -/
def integrand (s₀ σ : ℂ) (t u : ℝ) : ℂ :=
  inverseHeight s₀ σ u * ((character t u : Circle) : ℂ)⁻¹

/-- The normalized logarithmic-coordinate Fourier integral, with measure `du`. -/
def fourier (s₀ σ : ℂ) (t : ℝ) : ℂ := ∫ u : ℝ, integrand s₀ σ t u

/-- The chosen coordinate measure makes the lattice generated by `v₀` unimodular. -/
theorem coordinate_unit_interval : volume (Ioc (0 : ℝ) 1) = 1 := by simp

theorem inverseHeight_nonneg (s₀ σ : ℂ) {u : ℝ} (hu : 0 ≤ u) :
    inverseHeight s₀ σ u = Complex.exp (-s₀ * u) := by
  unfold inverseHeight supportFunction
  simp only [min_self, min_eq_right (neg_nonpos.mpr hu)]
  congr 1
  push_cast
  ring

theorem inverseHeight_nonpos (s₀ σ : ℂ) {u : ℝ} (hu : u ≤ 0) :
    inverseHeight s₀ σ u = Complex.exp ((2 * σ) * u) := by
  unfold inverseHeight supportFunction
  simp only [min_self, min_eq_left (neg_nonneg.mpr hu)]
  congr 1
  push_cast
  ring

/-- Inverting the character gives the plus sign in the positive-half-line denominator. -/
theorem integrand_nonneg (s₀ σ : ℂ) (t : ℝ) {u : ℝ} (hu : 0 ≤ u) :
    integrand s₀ σ t u = Complex.exp (-(s₀ + 2 * Real.pi * Complex.I * t) * u) := by
  unfold integrand
  rw [inverseHeight_nonneg s₀ σ hu]
  change Complex.exp _ * (Complex.exp (((2 * Real.pi * t * u : ℝ) : ℂ) * Complex.I))⁻¹ = _
  rw [← Complex.exp_neg, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- The negative half-line has the complementary minus sign. -/
theorem integrand_nonpos (s₀ σ : ℂ) (t : ℝ) {u : ℝ} (hu : u ≤ 0) :
    integrand s₀ σ t u = Complex.exp ((2 * σ - 2 * Real.pi * Complex.I * t) * u) := by
  unfold integrand
  rw [inverseHeight_nonpos s₀ σ hu]
  change Complex.exp _ * (Complex.exp (((2 * Real.pi * t * u : ℝ) : ℂ) * Complex.I))⁻¹ = _
  rw [← Complex.exp_neg, ← Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem positive_rate_re (s₀ : ℂ) (t : ℝ) :
    (s₀ + 2 * Real.pi * Complex.I * t).re = s₀.re := by simp

private theorem negative_rate_re (σ : ℂ) (t : ℝ) :
    (2 * σ - 2 * Real.pi * Complex.I * t).re = 2 * σ.re := by simp

theorem integrableOn_positive (s₀ σ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) :
    IntegrableOn (integrand s₀ σ t) (Ioi 0) := by
  have h : (-(s₀ + 2 * Real.pi * Complex.I * t)).re < 0 := by
    simpa only [Complex.neg_re, positive_rate_re, neg_lt_zero] using h₀
  exact (integrableOn_exp_mul_complex_Ioi h 0).congr_fun
    (fun u hu => (integrand_nonneg s₀ σ t (le_of_lt hu)).symm) measurableSet_Ioi

theorem integrableOn_negative (s₀ σ : ℂ) (t : ℝ) (hσ : 0 < σ.re) :
    IntegrableOn (integrand s₀ σ t) (Iic 0) := by
  have h : 0 < (2 * σ - 2 * Real.pi * Complex.I * t).re := by
    rw [negative_rate_re]
    positivity
  exact (integrableOn_exp_mul_complex_Iic h 0).congr_fun
    (fun u hu => (integrand_nonpos s₀ σ t hu).symm) measurableSet_Iic

/-- Absolute integrability is proved, not inferred from a totalized integral value. -/
theorem integrable (s₀ σ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) (hσ : 0 < σ.re) :
    Integrable (integrand s₀ σ t) := by
  have h := (integrableOn_negative s₀ σ t hσ).union (integrableOn_positive s₀ σ t h₀)
  simpa only [Iic_union_Ioi, integrableOn_univ] using h

theorem integrable_inverseHeight (s₀ σ : ℂ) (h₀ : 0 < s₀.re) (hσ : 0 < σ.re) :
    Integrable (inverseHeight s₀ σ) := by
  have h := integrable s₀ σ 0 h₀ hσ
  change Integrable (fun u => integrand s₀ σ 0 u) at h
  simpa [integrand, character] using h

theorem integral_positive (s₀ σ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) :
    ∫ u : ℝ in Ioi 0, integrand s₀ σ t u = 1 / (s₀ + 2 * Real.pi * Complex.I * t) := by
  have h : (-(s₀ + 2 * Real.pi * Complex.I * t)).re < 0 := by
    simpa only [Complex.neg_re, positive_rate_re, neg_lt_zero] using h₀
  calc
    _ = ∫ u : ℝ in Ioi 0, Complex.exp (-(s₀ + 2 * Real.pi * Complex.I * t) * u) :=
      setIntegral_congr_fun measurableSet_Ioi (fun u hu => integrand_nonneg s₀ σ t (le_of_lt hu))
    _ = _ := by
      rw [integral_exp_mul_complex_Ioi h 0]
      simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, neg_div_neg_eq]

theorem integral_negative (s₀ σ : ℂ) (t : ℝ) (hσ : 0 < σ.re) :
    ∫ u : ℝ in Iic 0, integrand s₀ σ t u = 1 / (2 * σ - 2 * Real.pi * Complex.I * t) := by
  have h : 0 < (2 * σ - 2 * Real.pi * Complex.I * t).re := by
    rw [negative_rate_re]
    positivity
  calc
    _ = ∫ u : ℝ in Iic 0, Complex.exp ((2 * σ - 2 * Real.pi * Complex.I * t) * u) :=
      setIntegral_congr_fun measurableSet_Iic (fun u hu => integrand_nonpos s₀ σ t hu)
    _ = _ := by simpa using integral_exp_mul_complex_Iic h 0

/-- The paper's archimedean factor, obtained by integrating both half-lines. -/
theorem fourier_eq_sum (s₀ σ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) (hσ : 0 < σ.re) :
    fourier s₀ σ t = 1 / (s₀ + 2 * Real.pi * Complex.I * t) +
      1 / (2 * σ - 2 * Real.pi * Complex.I * t) := by
  rw [fourier, ← intervalIntegral.integral_Iic_add_Ioi (integrableOn_negative s₀ σ t hσ)
    (integrableOn_positive s₀ σ t h₀), integral_negative s₀ σ t hσ, integral_positive s₀ σ t h₀]
  exact add_comm _ _

theorem positive_denominator_ne_zero (s₀ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) :
    s₀ + 2 * Real.pi * Complex.I * t ≠ 0 := by
  intro h
  have hr := congrArg Complex.re h
  rw [positive_rate_re, Complex.zero_re] at hr
  exact h₀.ne' hr

theorem negative_denominator_ne_zero (σ : ℂ) (t : ℝ) (hσ : 0 < σ.re) :
    2 * σ - 2 * Real.pi * Complex.I * t ≠ 0 := by
  intro h
  have hr := congrArg Complex.re h
  rw [negative_rate_re, Complex.zero_re] at hr
  linarith

/-- Combining the two pieces checks the cancellation of the spectral terms in the numerator. -/
theorem fourier_eq_fraction (s₀ σ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) (hσ : 0 < σ.re) :
    fourier s₀ σ t = (s₀ + 2 * σ) /
      ((s₀ + 2 * Real.pi * Complex.I * t) * (2 * σ - 2 * Real.pi * Complex.I * t)) := by
  rw [fourier_eq_sum s₀ σ t h₀ hσ]
  have ha := positive_denominator_ne_zero s₀ t h₀
  have hb := negative_denominator_ne_zero σ t hσ
  rw [one_div_add_one_div ha hb]
  congr 1
  ring

/-- The unsimplified `2πi` expression from `eqn:infiniteHeightFourierTransform`. -/
theorem fourier_eq_paper_factor (s₀ σ : ℂ) (t : ℝ) (h₀ : 0 < s₀.re) (hσ : 0 < σ.re) :
    fourier s₀ σ t = (-1 / (2 * Real.pi * Complex.I)) *
      ((s₀ + 2 * σ) / (2 * Real.pi * Complex.I)) *
      (1 / (((t : ℂ) + s₀ / (2 * Real.pi * Complex.I)) *
        ((t : ℂ) - (2 * σ) / (2 * Real.pi * Complex.I)))) := by
  rw [fourier_eq_fraction s₀ σ t h₀ hσ]
  let c : ℂ := 2 * Real.pi * Complex.I
  have hc : c ≠ 0 := by
    dsimp [c]
    exact mul_ne_zero (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
      Complex.I_ne_zero
  have ha : s₀ + c * t ≠ 0 := positive_denominator_ne_zero s₀ t h₀
  have hb : 2 * σ - c * t ≠ 0 := negative_denominator_ne_zero σ t hσ
  have hleft : (t : ℂ) + s₀ / c = (s₀ + c * t) / c := by field_simp; ring
  have hright : (t : ℂ) - 2 * σ / c = -(2 * σ - c * t) / c := by field_simp; ring
  change (s₀ + 2 * σ) / ((s₀ + c * t) * (2 * σ - c * t)) =
    (-1 / c) * ((s₀ + 2 * σ) / c) * (1 / (((t : ℂ) + s₀ / c) * ((t : ℂ) - 2 * σ / c)))
  rw [hleft, hright]
  field_simp

/-- The same spectral parameter controls the finite factors and this denominator. -/
theorem fourier_eq_spectralParameter (s₀ σ : ℂ) (t : ℝ)
    (h₀ : 0 < s₀.re) (hσ : 0 < σ.re) :
    fourier s₀ σ t = (s₀ + 2 * σ) /
      ((s₀ + 2 * Real.pi * Complex.I * t) * (2 * FiniteEulerProduct.spectralParameter σ t)) := by
  rw [fourier_eq_fraction s₀ σ t h₀ hσ]
  congr 2
  unfold FiniteEulerProduct.spectralParameter
  ring

end Cubic.PoissonSummation.ArchimedeanFourier
