import Cubic.BoxAsymptotic.AngularIdealData
import Cubic.BoxAsymptotic.AngularLocal

/-! Multiplicativity of the actual ideal characters and the bijection from
primary elements to ideals. This identifies the element and ideal series,
without using an Euler product or assuming `eq:Dk`. -/

noncomputable section

namespace Cubic.BoxAsymptotic.AngularIdeals

open Cubic.PoissonSummation.CyclotomicIntegerUnits
open Cubic.Counting.EisensteinNormCount
open Cubic.BoxAsymptotic.AngularSeriesData Cubic.BoxAsymptotic.AngularLocalData
open Cubic.BoxAsymptotic.AngularIdealData Cubic.BoxAsymptotic.PrimaryGenerator
open Cubic.BoxAsymptotic.EisensteinCoordinates
open CubicTargets.BoxAsymptotic

theorem coordinates_mul (x y : Integers) :
    coordinates (x * y) = mulE (coordinates x) (coordinates y) := by
  apply coord_injective
  simp [coord_mulE]

theorem generator_ne_zero (I : Ideal Integers) (hI : ¬ 3 ∣ Ideal.absNorm I) :
    generator I ≠ 0 := by
  intro h
  have hp := (generator_spec I hI).2
  simp [IsPrimary, h] at hp

theorem generator_eis_ne_zero (I : Ideal Integers) (hI : ¬ 3 ∣ Ideal.absNorm I) :
    eis (coordinates (generator I)) ≠ 0 := by
  apply eis_ne_zero
  intro h
  apply generator_ne_zero I hI
  rw [← coord_coordinates (generator I), h]
  simp [coord]

theorem psi_mul (k : ℤ) (I J : Ideal Integers) : psi k (I * J) = psi k I * psi k J := by
  have hd : 3 ∣ Ideal.absNorm (I * J) ↔ 3 ∣ Ideal.absNorm I ∨ 3 ∣ Ideal.absNorm J := by
    rw [map_mul, Nat.prime_three.dvd_mul]
  by_cases hI : 3 ∣ Ideal.absNorm I
  · simp only [psi, hd, hI, true_or, ite_true, zero_mul]
  by_cases hJ : 3 ∣ Ideal.absNorm J
  · simp only [psi, hd, hJ, or_true, ite_true, mul_zero]
  simp only [psi, hd, hI, hJ, or_self, ite_false]
  rw [generator_mul hI hJ, coordinates_mul, eis_mulE]
  exact phase_mul k (generator_eis_ne_zero I hI) (generator_eis_ne_zero J hJ)

theorem norm_psi (k : ℤ) (I : Ideal Integers) (hI : ¬ 3 ∣ Ideal.absNorm I) :
    ‖psi k I‖ = 1 := by simp [psi, hI]

theorem psi_neg (k : ℤ) (I : Ideal Integers) : psi (-k) I = star (psi k I) := by
  unfold psi
  split_ifs <;> simp [phase_neg_index]

/-- The ideal generated by a lattice vector. -/
def spanCoord (p : ℤ × ℤ) : Ideal Integers := Ideal.span {coord p}

theorem norm_spanCoord {M : ℕ} {p : ℤ × ℤ} (hp : p ∈ primary M) :
    Ideal.absNorm (spanCoord p) = M ^ 3 := by
  rw [spanCoord, Ideal.absNorm_span_singleton, norm_coord, hp.1]
  simp

theorem prime_to_three_cube {M : ℕ} (hM : ¬ 3 ∣ M) : ¬ 3 ∣ M ^ 3 :=
  fun h => hM (Nat.prime_three.dvd_of_dvd_pow h)

theorem primary_generator_span {M : ℕ} (hM : ¬ 3 ∣ M) {p : ℤ × ℤ}
    (hp : p ∈ primary M) : generator (spanCoord p) = coord p := by
  apply generator_eq
  · rw [norm_spanCoord hp]
    exact prime_to_three_cube hM
  · exact (isPrimary_coord p).mpr hp.2
  · rfl

theorem spanCoord_injOn (M : ℕ) : (primary M).InjOn spanCoord := by
  intro p hp q hq h
  apply coord_injective
  exact unique ((isPrimary_coord p).mpr hp.2) ((isPrimary_coord q).mpr hq.2) h

theorem primary_image (M : ℕ) (hM : ¬ 3 ∣ M) :
    spanCoord '' primary M = cubeNormIdeals M := by
  ext I
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact norm_spanCoord hp
  · intro hI
    have hI3 : ¬ 3 ∣ Ideal.absNorm I := by
      rw [show Ideal.absNorm I = M ^ 3 from hI]
      exact prime_to_three_cube hM
    refine ⟨coordinates (generator I), ?_, ?_⟩
    · refine ⟨?_, (isPrimary_coord _).mp ?_⟩
      · have hn := congrArg Ideal.absNorm (generator_spec I hI3).1
        rw [Ideal.absNorm_span_singleton, ← coord_coordinates (generator I), norm_coord] at hn
        rw [show Ideal.absNorm I = M ^ 3 from hI] at hn
        change _ = (M : ℤ) ^ 3
        rw [← Int.natAbs_of_nonneg (normForm_nonneg _ _), hn]
        simp
      · simpa using (generator_spec I hI3).2
    · simpa [spanCoord] using (generator_spec I hI3).1

theorem psi_span {M : ℕ} (hM : ¬ 3 ∣ M) (k : ℤ) {p : ℤ × ℤ}
    (hp : p ∈ primary M) : psi k (spanCoord p) = phase k (eis p) := by
  have h3 : ¬ 3 ∣ Ideal.absNorm (spanCoord p) := by
    rw [norm_spanCoord hp]
    exact prime_to_three_cube hM
  simp [psi, h3, primary_generator_span hM hp]

theorem coefficient_eq (k : ℤ) (M : ℕ) : idealCoefficient k M = awayCoefficient k M := by
  classical
  by_cases hM : 3 ∣ M
  · simp [idealCoefficient, awayCoefficient, hM]
  simp only [idealCoefficient, awayCoefficient, hM, ite_false, angularSum]
  rw [← primary_image M hM, finsum_mem_image (spanCoord_injOn M)]
  exact finsum_mem_congr rfl fun p hp => psi_span hM k hp

theorem series_eq (k : ℤ) (s : ℂ) : idealSeries k s = awaySeries k s := by
  simp only [idealSeries, awaySeries, funext (coefficient_eq k)]

end Cubic.BoxAsymptotic.AngularIdeals
